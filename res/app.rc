// app.rc - application resources.
//
// NOTE: no manifest is embedded here. MinGW's linker automatically links its own
// default-manifest.o and refuses to merge a second, non-default manifest
// ("multiple non-default manifests"). Per-monitor DPI awareness is therefore
// declared at startup in main.cpp, which works the same for MinGW and MSVC.
#include <windows.h>

// Application icon (generated by tools/make_icon.py).
APPICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "AudioConverter"
            VALUE "FileDescription",  "Batch audio converter (MP3 / FLAC / M4A / NCM -> FLAC / WAV)"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "AudioConverter"
            VALUE "OriginalFilename", "AudioConverter.exe"
            VALUE "ProductName",      "AudioConverter"
            VALUE "ProductVersion",   "2.0.0.0"
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
